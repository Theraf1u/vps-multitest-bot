# Telegram bot token from @BotFather
BOT_TOKEN=

# Your numeric Telegram user id — only this user can access the admin panel
ADMIN_ID=

# Default OpenRouter model (can be changed later from the admin panel)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Initial OpenRouter API key (optional — can also be set/changed from the admin panel,
# where it is stored encrypted in the DB). Leave empty to configure it later via /start -> admin.
OPENROUTER_API_KEY=

# Any secret string; used to derive the key that encrypts the OpenRouter API key at rest.
MASTER_ENCRYPTION_KEY=

# Concurrency limits
MAX_CONCURRENT_TESTS=3
MAX_TESTS_PER_USER=1

# If Telegram/OpenRouter/outbound SSH need to go through a proxy from your host (e.g. Telegram
# is blocked in your region without a VPN), point these at a SOCKS5/HTTP proxy. Leave empty to
# connect directly — that's the right default for most hosts.
TELEGRAM_PROXY_URL=
OPENROUTER_PROXY_URL=
SSH_PROXY_URL=

# SSH connect+auth timeout in seconds. Default 45s — some VPS providers' sshd is slow to
# respond to a fresh client IP (commonly a blocking reverse-DNS lookup), so keep this generous.
SSH_CONNECT_TIMEOUT=45

# Storage
DB_PATH=/app/data/bot.db
REPORTS_DIR=/app/data/reports
REPORT_TTL_HOURS=24
# Permanent per-user report archive (PDF + raw text + AI summary). Never holds SSH
# credentials — see README "Безопасность".
ARCHIVE_DIR=/app/data/archive
